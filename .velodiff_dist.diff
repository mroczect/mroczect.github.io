diff --git a/public/retro.js b/public/retro.js
new file mode 100644
index 0000000..780f1d0
--- /dev/null
+++ b/public/retro.js
@@ -0,0 +1,45 @@
+window.addEventListener('load', () => {
+  const boot = document.getElementById('boot');
+  if (!boot) return;
+  setTimeout(() => boot.classList.add('hide'), 1600);
+});
+
+function tickClock() {
+  const el = document.querySelector('#taskbar .clock');
+  if (!el) return;
+  const d = new Date();
+  el.textContent =
+    String(d.getHours()).padStart(2, '0') + ':' +
+    String(d.getMinutes()).padStart(2, '0');
+}
+setInterval(tickClock, 1000);
+tickClock();
+
+let audioCtx;
+function playClick() {
+  try {
+    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
+    const o = audioCtx.createOscillator();
+    const g = audioCtx.createGain();
+    o.type = 'square';
+    o.frequency.value = 1200;
+    g.gain.setValueAtTime(0.04, audioCtx.currentTime);
+    g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
+    o.connect(g).connect(audioCtx.destination);
+    o.start();
+    o.stop(audioCtx.currentTime + 0.05);
+  } catch (e) {}
+}
+document.addEventListener('click', (e) => {
+  if (e.target.closest('a, button, .btn95, .start-btn')) playClick();
+}, { passive: true });
+
+document.addEventListener('DOMContentLoaded', () => {
+  const here = location.pathname;
+  document.querySelectorAll('#navigation a').forEach(a => {
+    try {
+      const href = new URL(a.href).pathname;
+      if (href !== '/' && here.startsWith(href)) a.classList.add('active');
+    } catch (e) {}
+  });
+});
