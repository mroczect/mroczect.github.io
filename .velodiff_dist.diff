+{% extends "base.html" %} {% block content %} {{ section.content | safe }} {%
+set blog = get_section(path="blog/_index.md", required=false) %} {% if blog and
+blog.pages %}
+<hr />
+<h2>Blog</h2>
+<ul class="post-list">
+	{% for page in blog.pages %}
+	<li>
+		{% if page.date %}<span class="date">{{ page.date }}</span>{% endif %}
+		<a href="{{ page.permalink }}">{{ page.title }}</a>
+	</li>
+	{% endfor %}
+</ul>
+{% endif %} {% if section.pages %}
+<hr />
+<h2>Pages</h2>
+<ul class="post-list">
+	{% for page in section.pages %}
+	<li>
+		{% if page.date %}<span class="date">{{ page.date }}</span>{% endif %}
+		<a href="{{ page.permalink }}">{{ page.title }}</a>
+	</li>
+	{% endfor %}
+</ul>
+{% endif %} {% endblock %}
diff --git a/templates/page.html b/templates/page.html
new file mode 100644
index 0000000..ca48dd7
--- /dev/null
+++ b/templates/page.html
@@ -0,0 +1,39 @@
+{% extends "base.html" %} {% block title %}{{ page.title }} - {{ config.title
+}}{% endblock %} {% block content %}
+<p><a class="btn95" href="{{ get_url(path='@/_index.md') }}">&larr; home</a></p>
+
+<h1>{{ page.title }}</h1>
+
+<p class="meta">
+	{% if page.date %}{{ page.date }}{% endif %} {% if page.reading_time %}
+	&middot; {{ page.reading_time }} min{% endif %}
+</p>
+
+{% if page.taxonomies.tags %}
+<div class="tags">
+	{% for tag in page.taxonomies.tags %}
+	<a href="{{ get_taxonomy_url(kind='tags', name=tag) }}">#{{ tag }}</a>
+	{% endfor %}
+</div>
+{% endif %} {% if page.toc and page.toc | length > 0 %}
+<nav class="toc">
+	<ul>
+		{% for h in page.toc %}
+		<li>
+			<a href="{{ h.permalink }}">{{ h.title }}</a>
+			{% if h.children %}
+			<ul>
+				{% for c in h.children %}
+				<li><a href="{{ c.permalink }}">{{ c.title }}</a></li>
+				{% endfor %}
+			</ul>
+			{% endif %}
+		</li>
+		{% endfor %}
+	</ul>
+</nav>
+{% endif %}
+
+<hr />
+
+{{ page.content | safe }} {% endblock %}
diff --git a/templates/section.html b/templates/section.html
new file mode 100644
index 0000000..45768bd
--- /dev/null
+++ b/templates/section.html
@@ -0,0 +1,41 @@
+{% extends "base.html" %} {% block title %}{{ section.title }} - {{ config.title
+}}{% endblock %} {% block content %}
+<p><a class="btn95" href="{{ get_url(path='@/_index.md') }}">&larr; home</a></p>
+
+<h1>{{ section.title }}</h1>
+
+{{ section.content | safe }} {% if paginator %}
+<ul class="post-list">
+	{% for page in paginator.pages %}
+	<li>
+		{% if page.date %}<span class="date">{{ page.date }}</span>{% endif %}
+		<a href="{{ page.permalink }}">{{ page.title }}</a>
+	</li>
+	{% endfor %}
+</ul>
+
+<nav class="pagination">
+	{% if paginator.previous %}
+	<a href="{{ paginator.previous }}">&larr; Prev</a>
+	{% else %}
+	<span>&larr; Prev</span>
+	{% endif %}
+	<span class="current"
+		>{{ paginator.current_index }} / {{ paginator.number_pagers }}</span
+	>
+	{% if paginator.next %}
+	<a href="{{ paginator.next }}">Next &rarr;</a>
+	{% else %}
+	<span>Next &rarr;</span>
+	{% endif %}
+</nav>
+{% elif section.pages %}
+<ul class="post-list">
+	{% for page in section.pages %}
+	<li>
+		{% if page.date %}<span class="date">{{ page.date }}</span>{% endif %}
+		<a href="{{ page.permalink }}">{{ page.title }}</a>
+	</li>
+	{% endfor %}
+</ul>
+{% endif %} {% endblock %}
